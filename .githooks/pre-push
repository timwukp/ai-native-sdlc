#!/bin/sh
set -eu

remote_name=${1:-}
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "privacy pre-push: not inside a Git repository" >&2
  exit 2
}
scanner="$root/scripts/privacy_scan.py"

command -v python3 >/dev/null 2>&1 || {
  echo "privacy pre-push: python3 is required" >&2
  exit 2
}
[ -f "$scanner" ] || {
  echo "privacy pre-push: checked-in scanner is missing" >&2
  exit 2
}

exec python3 "$scanner" --repo "$root" --pre-push --remote "$remote_name"
